rules_version = '2';
// The browser never reads/writes Firestore. Only the FastAPI backend does, through
// the Admin SDK (which ignores these rules). Deny everything else, so API keys and
// mail drafts can never be read by a client, even a logged-in one.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
